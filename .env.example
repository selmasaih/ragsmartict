# ── LLM provider : "groq" (cloud, gratuit + rapide, recommandé pour déployer)
#                  "ollama" (local, privé) ou "gemini" (cloud) ────────
LLM_PROVIDER="groq"

# Groq — clé gratuite sur https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
# Qualité : llama-3.3-70b-versatile  |  Max de marge anti-limites : llama-3.1-8b-instant
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_MAX_TOKENS="1024"

# Si LLM_PROVIDER="gemini", ajoutez votre clé API
GOOGLE_API_KEY="your_google_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# ── Paramètres Ollama ────────────────────────────────────────────────
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_API_URL="http://127.0.0.1:11434/api/generate"
OLLAMA_NUM_PREDICT="512"
OLLAMA_TIMEOUT_S="300"

# ── Serveur / API ────────────────────────────────────────────────────
# Origines CORS autorisées (séparées par des virgules). "*" = tout autoriser (dev only).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
MAX_QUESTION_CHARS="2000"
LOG_LEVEL="INFO"

# ── Récupération ─────────────────────────────────────────────────────
ENABLE_QUERY_REWRITE="false"
